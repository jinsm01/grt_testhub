  <data key="d4">unknown_source</data>
  <data key="d5">1780036813</data>
  <data key="d6"></data>
</node>
<node id="排序">
  <data key="d0">排序</data>
  <data key="d1">concept</data>
  <data key="d2">排序是工具栏中用于对数据列表进行排序的功能。</data>
  <data key="d3">chunk-df8733f0afe6c368952e7dcce7af300f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1780036813</data>
  <data key="d6"></data>
</node>
<node id="搜索框">
  <data key="d0">搜索框</data>
  <data key="d1">artifact</data>
  <data key="d2">搜索框是工具栏中的功能组件，用于输入关键词搜索数据。&lt;SEP&gt;搜索框是用户输入搜索内容的界面元素，用于触发搜索操作。&lt;SEP&gt;搜索框是工具栏中的功能控件，用于根据字段内容进行搜索。</data>
  <data key="d3">chunk-df8733f0afe6c368952e7dcce7af300f&lt;SEP&gt;chunk-0a085fbb7a65b60140d06a8a97cfbe64&lt;SEP&gt;chunk-37d70258cd3425e97aed253665baac35</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1780036814</data>
  <data key="d6"></data>
</node>
<node id="刷新">
  <data key="d0">刷新</data>
  <data key="d1">artifact</data>
  <data key="d2">刷新是工具栏中的功能组件，用于重新加载数据列表。</data>
  <data key="d3">chunk-df8733f0afe6c368952e7dcce7af300f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1780036814</data>
  <data key="d6"></data>
</node>
<node id="导入">
  <data key="d0">导入</data>
  <data key="d1">artifact</data>
  <data key="d2">导入是工具栏中的功能组件，用于导入外部数据。&lt;SEP&gt;导入是将外部数据文件上传到系统中的操作。</data>
  <data key="d3">chunk-df8733f0afe6c368952e7dcce7af300f&lt;SEP&gt;chunk-18512f38d43fa875be12793e3f45ce6a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1780036814</data>
  <data key="d6"></data>
</node>
<node id="导出">
  <data key="d0">导出</data>
  <data key="d1">artifact</data>
  <data key="d2">导出是工具栏中的功能组件，用于将数据导出为文件。</data>
  <data key="d3">chunk-df8733f0afe6c368952e7dcce7af300f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1780036814</data>
  <data key="d6"></data>
</node>
<node id="创建">
  <data key="d0">创建</data>
  <data key="d1">artifact</data>
  <data key="d2">创建是工具栏中的功能组件，用于新建数据记录。&lt;SEP&gt;创建是用户在页面上新增记录的操作动作。&lt;SEP&gt;创建是用户新增数据条目的操作。&lt;SEP&gt;创建是用户在右侧操作按钮中点击“创建”触发的操作，用于新增记录。</data>
  <data key="d3">chunk-df8733f0afe6c368952e7dcce7af300f&lt;SEP&gt;chunk-0a085fbb7a65b60140d06a8a97cfbe64&lt;SEP&gt;chunk-838609590d19b00c0f595d2ef814304d&lt;SEP&gt;chunk-37d70258cd3425e97aed253665baac35</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1780036814</data>
  <data key="d6"></data>
</node>
<node id="草稿">
  <data key="d0">草稿</data>
  <data key="d1">concept</data>
  <data key="d2">草稿是指未提交到审批流的数据状态。&lt;SEP&gt;草稿是指尚未提交的数据记录。</data>
  <data key="d3">chunk-df8733f0afe6c368952e7dcce7af300f&lt;SEP&gt;chunk-04a3b728d0d1e5e664278f31e5ed09de</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1780036814</data>
  <data key="d6"></data>
</node>
<node id="审批中">
  <data key="d0">审批中</data>
  <data key="d1">concept</data>
  <data key="d2">审批中是审批状态的一种，表示数据正在被审批过程中。&lt;SEP&gt;审批中是记录的一种状态，仅允许查看。&lt;SEP&gt;审批中是指数据正在被审批的状态。&lt;SEP&gt;审批中是审批状态的一种，此时不显示操作按钮，但可以撤回。</data>
  <data key="d3">chunk-df8733f0afe6c368952e7dcce7af300f&lt;SEP&gt;chunk-68f98d20334da6fa7758c7f5fc34c477&lt;SEP&gt;chunk-65a291dbb9e4ae14f901c353e87ae165&lt;SEP&gt;chunk-18512f38d43fa875be12793e3f45ce6a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1780036814</data>
  <data key="d6"></data>
</node>
<node id="审批未通过">
  <data key="d0">审批未通过</data>
  <data key="d1">concept</data>
  <data key="d2">审批未通过是审批状态的一种，表示数据未通过审批。&lt;SEP&gt;审批未通过是指数据未通过审批的状态。</data>
  <data key="d3">chunk-df8733f0afe6c368952e7dcce7af300f&lt;SEP&gt;chunk-68f98d20334da6fa7758c7f5fc34c477</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1780036814</data>
  <data key="d6"></data>
</node>
<node id="审批通过">
  <data key="d0">审批通过</data>
  <data key="d1">concept</data>
  <data key="d2">审批通过是审批状态的一种，表示数据已通过审批。&lt;SEP&gt;审批通过是记录的一种状态，仅允许查看。&lt;SEP&gt;审批通过是指数据已通过审批的状态。</data>
  <data key="d3">chunk-df8733f0afe6c368952e7dcce7af300f&lt;SEP&gt;chunk-68f98d20334da6fa7758c7f5fc34c477&lt;SEP&gt;chunk-18512f38d43fa875be12793e3f45ce6a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1780036814</data>
  <data key="d6"></data>
</node>
<node id="查看">
  <data key="d0">查看</data>
  <data key="d1">method</data>
  <data key="d2">查看是一种对记录进行浏览的操作，根据审批状态显示不同的按钮。&lt;SEP&gt;查看是操作功能之一，所有状态均可见。&lt;SEP&gt;查看是用户在页面上浏览记录的操作动作。&lt;SEP&gt;查看是用户查看数据条目详细信息的操作。&lt;SEP&gt;查看是用户在操作列中进行的操作，用于查看记录详情。</data>
  <data key="d3">chunk-df8733f0afe6c368952e7dcce7af300f&lt;SEP&gt;chunk-0a085fbb7a65b60140d06a8a97cfbe64&lt;SEP&gt;chunk-18512f38d43fa875be12793e3f45ce6a&lt;SEP&gt;chunk-838609590d19b00c0f595d2ef814304d&lt;SEP&gt;chunk-37d70258cd3425e97aed253665baac35</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1780036814</data>
  <data key="d6"></data>
</node>
<node id="编辑">
  <data key="d0">编辑</data>
  <data key="d1">method</data>
  <data key="d2">编辑是一种对记录进行修改的操作，仅在特定审批状态下可见。&lt;SEP&gt;编辑是操作功能之一，仅在特定状态下可见。&lt;SEP&gt;编辑是用户在页面上修改记录的操作动作。&lt;SEP&gt;编辑是用户修改数据条目信息的操作。&lt;SEP&gt;编辑是用户在操作列中进行的操作，用于修改记录内容。</data>
  <data key="d3">chunk-df8733f0afe6c368952e7dcce7af300f&lt;SEP&gt;chunk-0a085fbb7a65b60140d06a8a97cfbe64&lt;SEP&gt;chunk-18512f38d43fa875be12793e3f45ce6a&lt;SEP&gt;chunk-838609590d19b00c0f595d2ef814304d&lt;SEP&gt;chunk-37d70258cd3425e97aed253665baac35</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1780036814</data>
  <data key="d6"></data>
</node>
<node id="删除">
  <data key="d0">删除</data>
  <data key="d1">method</data>
  <data key="d2">删除是移除审批流的操作。&lt;SEP&gt;删除是一种对记录进行移除的操作，仅在特定审批状态下可见。&lt;SEP&gt;删除是操作功能之一，仅在特定状态下可见。&lt;SEP&gt;删除是用户在页面上移除记录的操作动作。&lt;SEP&gt;删除是用户移除数据条目的操作。&lt;SEP&gt;删除是用户在操作列中进行的操作，用于删除记录。</data>
  <data key="d3">chunk-df8733f0afe6c368952e7dcce7af300f&lt;SEP&gt;chunk-0a085fbb7a65b60140d06a8a97cfbe64&lt;SEP&gt;chunk-1abcba8fdfda2ae7aac78156ea07bf9b&lt;SEP&gt;chunk-18512f38d43fa875be12793e3f45ce6a&lt;SEP&gt;chunk-838609590d19b00c0f595d2ef814304d&lt;SEP&gt;chunk-37d70258cd3425e97aed253665baac35</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1780036814</data>
  <data key="d6"></data>
</node>
<node id="导出数据">
  <data key="d0">导出数据</data>
  <data key="d1">concept</data>
  <data key="d2">导出数据是指在系统中根据当前筛选条件将数据导出为文件的操作。&lt;SEP&gt;导出数据是将表单数据保存为文件的操作。</data>
  <data key="d3">chunk-04a3b728d0d1e5e664278f31e5ed09de&lt;SEP&gt;chunk-18512f38d43fa875be12793e3f45ce6a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1780036814</data>
  <data key="d6"></data>
</node>
<node id="下载中心">
  <data key="d0">下载中心</data>
  <data key="d1">location</data>
  <data key="d2">下载中心是用户获取导出文件的区域，位于界面右上角。&lt;SEP&gt;下载中心是用户下载导出文件的区域。</data>
  <data key="d3">chunk-04a3b728d0d1e5e664278f31e5ed09de&lt;SEP&gt;chunk-18512f38d43fa875be12793e3f45ce6a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1780036814</data>
  <data key="d6"></data>
</node>
<node id="应用名称">
  <data key="d0">应用名称</data>
  <data key="d1">organization</data>
  <data key="d2">应用名称是导出模块中指定的应用标识。&lt;SEP&gt;应用名称是当前操作的应用程序名称。</data>
  <data key="d3">chunk-04a3b728d0d1e5e664278f31e5ed09de&lt;SEP&gt;chunk-18512f38d43fa875be12793e3f45ce6a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1780036814</data>
  <data key="d6"></data>
</node>
<node id="资源名称">
  <data key="d0">资源名称</data>
  <data key="d1">concept</data>
  <data key="d2">资源名称是资源列表中的一个字段，用于标识资源的名称。&lt;SEP&gt;资源名称是文件名的一部分，用于标识导出的数据内容。</data>
  <data key="d3">chunk-04a3b728d0d1e5e664278f31e5ed09de&lt;SEP&gt;chunk-ff4ad8acb2f5dc7c34850a1b7551650b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1780036814</data>
  <data key="d6"></data>
</node>
<node id="时间戳">
  <data key="d0">时间戳</data>
  <data key="d1">data</data>
  <data key="d2">时间戳是文件名的一部分，用于标识文件生成的时间。</data>
  <data key="d3">chunk-04a3b728d0d1e5e664278f31e5ed09de</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1780036814</data>
  <data key="d6"></data>
</node>
<node id="批量导入信息.xlsx">
  <data key="d0">批量导入信息.xlsx</data>
  <data key="d1">artifact</data>
  <data key="d2">批量导入信息.xlsx是用于导入数据的模板文件。</data>
  <data key="d3">chunk-04a3b728d0d1e5e664278f31e5ed09de&lt;SEP&gt;chunk-18512f38d43fa875be12793e3f45ce6a</data>
