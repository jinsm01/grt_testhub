  <data key="d6"></data>
</node>
<node id="文本">
  <data key="d0">文本</data>
  <data key="d1">content</data>
  <data key="d2">文本是字段类型的一种，支持中英文、数字，用于输入文字内容。</data>
  <data key="d3">chunk-9ed43fd2cf6ce6a4fbd6e05236731ce0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1780036822</data>
  <data key="d6"></data>
